<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/bg" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="2dp" android:paddingRight="2dp" android:paddingTop="2dp" android:paddingBottom="3dp">
        <ImageView android:id="@+id/scene_top" android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginBottom="2dp" android:scaleType="centerCrop" android:visibility="gone" />
        <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="30dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="6dp" android:paddingRight="6dp">
            <TextView android:id="@+id/prev" android:layout_width="34dp" android:layout_height="match_parent"
                android:gravity="center" android:text="‹" android:textSize="24dp" android:includeFontPadding="false" />
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center" android:minWidth="80dp" android:textSize="15dp" android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" android:text="Shifts" android:includeFontPadding="false" />
            <ImageView android:id="@+id/title_img" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:adjustViewBounds="true" android:scaleType="fitCenter" android:visibility="gone" />
            <TextView android:id="@+id/next" android:layout_width="34dp" android:layout_height="match_parent"
                android:gravity="center" android:text="›" android:textSize="24dp" android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <TextView android:id="@+id/earn_head" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center_vertical|end" android:textSize="10.5dp" android:textStyle="bold" android:maxLines="2"
                android:lineSpacingMultiplier="0.95" android:paddingLeft="4dp" android:paddingRight="2dp" android:includeFontPadding="false" android:visibility="gone" />
            <FrameLayout android:id="@+id/btn_box" android:layout_width="wrap_content" android:layout_height="match_parent">
                <ImageView android:id="@+id/btn_ink" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:visibility="gone" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/add" android:layout_width="38dp" android:layout_height="match_parent"
                        android:gravity="center" android:text="+" android:textSize="22dp" android:includeFontPadding="false" />
                    <TextView android:id="@+id/today" android:layout_width="30dp" android:layout_height="22dp"
                        android:gravity="center" android:text="12" android:textSize="12dp" android:textStyle="bold" android:includeFontPadding="false" />
                    <TextView android:id="@+id/settings" android:layout_width="38dp" android:layout_height="match_parent"
                        android:gravity="center" android:text="⋮" android:textSize="18dp" android:textStyle="bold" android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/dow_box" android:layout_width="match_parent" android:layout_height="14dp">
            <LinearLayout android:id="@+id/dow" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView android:id="@+id/d0" style="@style/Dow" />
                <TextView android:id="@+id/d1" style="@style/Dow" />
                <TextView android:id="@+id/d2" style="@style/Dow" />
                <TextView android:id="@+id/d3" style="@style/Dow" />
                <TextView android:id="@+id/d4" style="@style/Dow" />
                <TextView android:id="@+id/d5" style="@style/Dow" />
                <TextView android:id="@+id/d6" style="@style/Dow" />
            </LinearLayout>
            <ImageView android:id="@+id/dow_img" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:id="@+id/weeks_box" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView android:id="@+id/gridbg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/rect" android:scaleType="fitXY" android:visibility="gone" />
            <LinearLayout android:id="@+id/weeks" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" />
            <ImageView android:id="@+id/ink_ov" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:visibility="gone" />
        </FrameLayout>
        <ImageView android:id="@+id/scene_bot" android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginTop="2dp" android:scaleType="centerCrop" android:visibility="gone" />
        <FrameLayout android:id="@+id/earn_box" android:layout_width="match_parent" android:layout_height="18dp"
            android:layout_marginTop="2dp" android:paddingLeft="6dp" android:paddingRight="6dp" android:visibility="gone">
            <TextView android:id="@+id/earn_txt" android:layout_width="match_parent" android:layout_height="15dp"
                android:gravity="center_vertical" android:textSize="11dp" android:maxLines="1" android:includeFontPadding="false" />
            <ImageView android:id="@+id/earn_bar" android:layout_width="match_parent" android:layout_height="3dp"
                android:layout_gravity="bottom" android:scaleType="fitXY" />
        </FrameLayout>
        <TextView android:id="@+id/msg" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:padding="12dp" android:textSize="14dp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
