<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/chipbg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/rr_0" android:scaleType="fitXY" />
    <LinearLayout android:id="@+id/chip_in" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView android:id="@+id/bar" android:layout_width="3dp" android:layout_height="match_parent"
            android:src="@drawable/rr_0" android:scaleType="fitXY" />
        <TextView android:id="@+id/txt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingLeft="2dp" android:paddingRight="1dp" android:ellipsize="end"
            android:fontFamily="sans-serif-condensed" android:includeFontPadding="false" android:lineSpacingMultiplier="1.0" />
    </LinearLayout>
    <!-- the pen outline sits on top, so nothing (like the colour bar) can cover its left edge (v3.21) -->
    <ImageView android:id="@+id/chipln" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/ink_box" android:scaleType="fitXY" android:visibility="gone" />
</FrameLayout>
