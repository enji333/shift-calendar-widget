<?xml version="1.0" encoding="utf-8"?>
<!-- Cartoon box (v3.15): a thick outline with a solid offset shadow on the right and bottom, like comic bubble lettering.
     Shape layers keep their dp sizes however the box is stretched. Tinted with the pen colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="2.5dp" android:left="2.5dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="1.25dp" /></shape>
    </item>
    <item android:gravity="right|fill_vertical" android:width="2.5dp" android:top="2.5dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="1.25dp" /></shape>
    </item>
</layer-list>
