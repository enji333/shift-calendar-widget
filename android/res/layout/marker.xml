<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mk" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:layout_marginRight="0.5dp" android:layout_marginLeft="0.5dp">
    <ImageView android:id="@+id/mkbg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/rr_0" android:scaleType="fitXY" />
    <ImageView android:id="@+id/mkln" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/ink_box" android:scaleType="fitXY" android:visibility="gone" />
    <TextView android:id="@+id/txt" android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingLeft="2dp" android:paddingRight="1dp"
        android:gravity="center_vertical" android:ellipsize="end" android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false" android:textColor="#FFFFFFFF" />
</FrameLayout>
